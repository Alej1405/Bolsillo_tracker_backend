# Plantilla. Cópiala a .env y pon los valores reales:
#   cp .env.example .env
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/finance_tracker

# Generar una nueva con:  openssl rand -hex 32
SECRET_KEY=cambiame_por_una_cadena_aleatoria_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Correo saliente. La clave sale del panel de Resend; el dominio de
# RESEND_FROM tiene que estar verificado ahi o el envio se rechaza.
RESEND_API_KEY=re_pon_aqui_tu_clave
RESEND_FROM=Bolsillo <hola@mashaec.net>
