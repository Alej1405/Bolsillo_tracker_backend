# Plantilla. Cópiala a .env y pon los valores reales:
#   cp .env.example .env
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/finance_tracker

# Generar una nueva con:  openssl rand -hex 32
SECRET_KEY=cambiame_por_una_cadena_aleatoria_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Correo saliente. La clave sale del panel de Resend; el dominio de
# RESEND_FROM tiene que estar verificado ahi o el envio se rechaza.
RESEND_API_KEY=re_pon_aqui_tu_clave
RESEND_FROM=Bolsillo <hola@mashaec.net>

# Fotos de perfil: donde se guardan y cuanto pesan como maximo.
# La carpeta se crea sola al arrancar. En el servidor conviene apuntarla a una
# ruta que no se borre en cada despliegue.
# Carpeta de las fotos de perfil.
#
# En desarrollo vale la ruta relativa. EN EL SERVIDOR TIENE QUE APUNTAR FUERA
# DEL PROYECTO —por ejemplo /srv/bolsillo-media—: la carpeta de dentro esta en
# el .gitignore y cada despliegue la deja vacia, asi que los avatar_url de la
# base quedaban apuntando a archivos que ya no existian y el navegador pintaba
# su icono de imagen rota.
MEDIA_DIR=media
AVATAR_MAX_MB=2
